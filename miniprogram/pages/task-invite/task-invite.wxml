<view class="page">
  <view class="state-card" wx:if="{{pageLoading}}">
    <view class="state-icon state-icon-loading">···</view>
    <text class="state-title">正在加载邀请</text>
  </view>

  <view class="state-card" wx:elif="{{loadError}}">
    <view class="state-icon state-icon-invalid">!</view>
    <text class="state-title">邀请已失效</text>
    <text class="state-desc">{{loadError}}</text>
    <button class="secondary-button" bindtap="goHome">返回首页</button>
  </view>

  <view class="state-card" wx:elif="{{invitation}}">
    <view class="state-icon {{invitation.valid ? 'state-icon-valid' : (invitation.accepted ? 'state-icon-success' : 'state-icon-invalid')}}">
      {{invitation.valid ? '邀' : (invitation.accepted ? '✓' : '!')}}
    </view>

    <text class="state-title" wx:if="{{invitation.valid}}">协作邀请</text>
    <text class="state-title" wx:elif="{{invitation.accepted}}">邀请已领取</text>
    <text class="state-title" wx:else>邀请已失效</text>

    <view class="invite-info">
      <view class="info-row">
        <text class="info-label">任务</text>
        <text class="info-value">{{invitation.task_title}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">身份</text>
        <text class="role-badge">{{invitation.role_text}}</text>
      </view>
    </view>

    <text class="state-desc">{{invitation.message}}</text>

    <button class="primary-button" wx:if="{{invitation.valid}}" loading="{{accepting}}" disabled="{{accepting}}" bindtap="acceptInvitation">
      确认接受邀请
    </button>
    <button class="primary-button" wx:elif="{{invitation.accepted}}" bindtap="enterTask">进入任务</button>
    <button class="secondary-button" wx:else bindtap="goHome">返回首页</button>
  </view>
</view>
