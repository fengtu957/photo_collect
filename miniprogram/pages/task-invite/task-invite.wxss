.page {
  width: 100%;
  min-height: 100vh;
  padding: 48rpx 28rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.state-card {
  width: 100%;
  box-sizing: border-box;
  padding: 56rpx 36rpx 40rpx;
  border: 1rpx solid #eee;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.state-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 28rpx;
  border-radius: 52rpx;
  font-size: 48rpx;
  line-height: 104rpx;
  font-weight: 600;
  color: #fff;
}

.state-icon-loading {
  background: #1989fa;
}

.state-icon-valid {
  background: #ff9500;
}

.state-icon-success {
  background: #07c160;
}

.state-icon-invalid {
  background: #999;
}

.state-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #333;
}

.state-desc {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #666;
  word-break: break-all;
  overflow-wrap: break-word;
}

.invite-info {
  width: 100%;
  margin-top: 36rpx;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f8fafc;
}

.info-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1rpx solid #eee;
  text-align: left;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 104rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
  overflow-wrap: break-word;
}

.role-badge {
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #eef5ff;
  font-size: 26rpx;
  line-height: 1.4;
  color: #1989fa;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 88rpx;
  margin-top: 40rpx;
  padding: 0;
  border-radius: 10rpx;
  font-size: 32rpx;
  line-height: 88rpx;
}

.primary-button {
  background: #1989fa;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #d6e8ff;
  background: #eef5ff;
  color: #1989fa;
}

.primary-button::after,
.secondary-button::after {
  border: none;
}
