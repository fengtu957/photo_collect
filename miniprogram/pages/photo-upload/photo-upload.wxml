<view class="page">
  <!-- 任务信息 -->
  <view class="card" wx:if="{{task}}">
    <view class="card-title">{{task.title}}</view>
    <view class="card-desc" wx:if="{{task.description}}">{{task.description}}</view>
    <view class="spec-info">
      <text class="spec-label">照片规格：</text>
      <text class="spec-value">{{task.photo_spec.name}} ({{task.photo_spec.width}}×{{task.photo_spec.height}})</text>
    </view>
    <view class="spec-info" wx:if="{{task.task_code}}">
      <text class="spec-label">任务码：</text>
      <text class="spec-value">{{task.task_code}}</text>
    </view>
    <view class="spec-info" wx:if="{{task.photo_spec.background_color}}">
      <text class="spec-label">背景色要求：</text>
      <text class="spec-value">{{task.photo_spec.background_color}}</text>
    </view>
    <view class="spec-info" wx:if="{{task.photo_spec.max_size_kb > 0}}">
      <text class="spec-label">大小限制：</text>
      <text class="spec-value">{{task.photo_spec.max_size_kb}}K，超出会自动压缩</text>
    </view>
    <view class="task-status" wx:if="{{taskStatusText}}">
      <text class="task-status-text">{{taskStatusText}}</text>
    </view>
    <view class="photo-size-tip" wx:if="{{task && task.verification_code_enabled}}">
      <text class="photo-size-tip-text" wx:if="{{requiresVerificationCode}}">当前任务已开启采集校验码，提交前需要输入正确的校验码。</text>
      <text class="photo-size-tip-text" wx:else>当前任务已开启采集校验码，你作为任务创建者可直接提交。</text>
    </view>
  </view>

  <!-- 照片预览 -->
  <view class="section">
    <view class="section-title">上传照片</view>
    <view class="preview" wx:if="{{photoPath}}">
      <image class="photo" src="{{photoPath}}" mode="aspectFit" />
    </view>
    <view class="empty-preview" wx:else>
      <text class="empty-text">请选择照片</text>
    </view>
    <button class="choose-btn" bindtap="choosePhoto" disabled="{{!!taskUnavailableMessage || photoProcessing}}">
      {{backgroundProcessing ? '背景生成中...' : (photoProcessing ? '照片处理中...' : (photoPath ? '重新选择' : '选择照片'))}}
    </button>
    <view class="photo-size-tip" wx:if="{{task && task.photo_spec && task.photo_spec.max_size_kb > 0}}">
      <text class="photo-size-tip-text">当前任务限制 {{task.photo_spec.max_size_kb}}K，超出后会自动压缩，仍超出则无法提交。</text>
    </view>

    <view class="background-editor" wx:if="{{backgroundReplacementEnabled && photoPath}}">
      <view class="background-editor-head">
        <text class="background-editor-title">自动换背景</text>
        <text class="background-editor-status" wx:if="{{backgroundProcessing}}">生成中...</text>
        <text class="background-editor-status" wx:elif="{{backgroundState === 'pending'}}">等待 AI 检查</text>
        <text class="background-editor-status background-editor-status-success" wx:elif="{{backgroundState === 'success'}}">已生成</text>
        <text class="background-editor-status background-editor-status-error" wx:elif="{{backgroundState === 'error'}}">生成失败</text>
      </view>
      <text class="background-editor-note">按任务要求自动生成：{{backgroundColorText}}</text>
      <text class="background-error" wx:if="{{backgroundState === 'error'}}">{{backgroundError}}</text>
      <view class="analysis-actions" wx:if="{{backgroundState === 'error'}}">
        <button class="analysis-action-btn" bindtap="retryBackgroundReplacement" disabled="{{backgroundProcessing}}">重新生成背景</button>
      </view>
    </view>

    <view class="analysis-panel analysis-panel-existing" wx:if="{{aiAnalysisEnabled && analysisState === 'existing' && analysisMessage}}">
      <text class="analysis-note">{{analysisMessage}}</text>
    </view>

    <view class="analysis-panel analysis-panel-loading" wx:if="{{aiAnalysisEnabled && analysisState === 'analyzing'}}">
      <view class="analysis-panel-head">
        <text class="analysis-badge analysis-badge-loading">检查中</text>
        <text class="analysis-headline">AI 正在检查这张照片</text>
      </view>
      <text class="analysis-note">{{analysisMessage}}</text>
    </view>

    <view class="analysis-panel analysis-panel-error" wx:if="{{aiAnalysisEnabled && analysisState === 'error' && backgroundState !== 'error'}}">
      <view class="analysis-panel-head">
        <text class="analysis-badge analysis-badge-fail">检查失败</text>
        <text class="analysis-headline">照片处理失败，请重试</text>
      </view>
      <text class="analysis-note">{{analysisError}}</text>
      <view class="analysis-actions">
        <button class="analysis-action-btn" bindtap="retryAnalyzePhoto">重新检测</button>
      </view>
    </view>

    <view class="analysis-panel {{analysisPassed ? 'analysis-panel-pass' : 'analysis-panel-fail'}}" wx:if="{{aiAnalysisEnabled && analysisState === 'success' && analysisResult}}">
      <view class="analysis-panel-head">
        <text class="analysis-badge {{analysisPassed ? 'analysis-badge-pass' : 'analysis-badge-fail'}}">{{analysisPassed ? (photoProcessing ? '检查通过' : '可提交') : '需重拍'}}</text>
        <text class="analysis-headline">{{analysisMessage}}</text>
      </view>

      <view class="analysis-list" wx:if="{{analysisResult.issues && analysisResult.issues.length > 0}}">
        <text class="analysis-list-title">主要问题</text>
        <text class="analysis-list-item" wx:for="{{analysisResult.issues}}" wx:key="*this" wx:for-item="issue">{{issue}}</text>
      </view>

      <view class="analysis-list" wx:if="{{analysisResult.suggestions && analysisResult.suggestions.length > 0}}">
        <text class="analysis-list-title">调整建议</text>
        <text class="analysis-list-item" wx:for="{{analysisResult.suggestions}}" wx:key="*this" wx:for-item="suggestion">{{suggestion}}</text>
      </view>
    </view>

    <view class="analysis-panel analysis-panel-pass" wx:if="{{aiAnalysisEnabled && analysisState === 'fallback'}}">
      <view class="analysis-panel-head">
        <text class="analysis-badge analysis-badge-pass">可提交</text>
        <text class="analysis-headline">{{analysisMessage}}</text>
      </view>
      <text class="analysis-note">请自行确认照片清晰、正面且仅有一人。</text>
    </view>
  </view>

  <canvas
    id="background-canvas"
    type="2d"
    class="background-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>

  <view class="section" wx:if="{{requiresVerificationCode}}">
    <view class="section-title">输入校验码</view>
    <view class="card" id="verification-code-field">
      <input
        class="input"
        type="number"
        maxlength="32"
        placeholder="请输入数字校验码"
        value="{{verificationCodeInput}}"
        bindinput="onVerificationCodeInput"
        bindfocus="onInputFocus"
        bindkeyboardheightchange="onKeyboardHeightChange"
        data-target="verification-code-field"
        adjust-position="{{false}}"
      />
      <text class="verification-tip">该任务开启了校验码，仅支持输入数字，填写正确后才能提交或更新照片。</text>
    </view>
  </view>

  <!-- 自定义字段 -->
  <view class="section" wx:if="{{task && task.custom_fields && task.custom_fields.length > 0}}">
    <view class="section-title">填写信息</view>
    <view class="card">
      <view class="field-item" wx:for="{{task.custom_fields}}" wx:key="id" id="custom-field-{{index}}">
        <view class="field-label">
          <text>{{item.label}}</text>
          <text class="required" wx:if="{{item.required}}">*</text>
        </view>

        <!-- 文本输入 -->
        <input
          wx:if="{{item.type === 'text'}}"
          class="input"
          placeholder="{{item.placeholder || '请输入' + item.label}}"
          value="{{customData[item.id]}}"
          data-field="{{item.id}}"
          data-target="custom-field-{{index}}"
          bindinput="onCustomFieldInput"
          bindfocus="onInputFocus"
          bindkeyboardheightchange="onKeyboardHeightChange"
          adjust-position="{{false}}"
        />

        <!-- 数字输入 -->
        <input
          wx:if="{{item.type === 'number'}}"
          class="input"
          type="number"
          placeholder="{{item.placeholder || '请输入' + item.label}}"
          value="{{customData[item.id]}}"
          data-field="{{item.id}}"
          data-target="custom-field-{{index}}"
          bindinput="onCustomFieldInput"
          bindfocus="onInputFocus"
          bindkeyboardheightchange="onKeyboardHeightChange"
          adjust-position="{{false}}"
        />

        <!-- 单选 -->
        <picker
          wx:if="{{item.type === 'select'}}"
          mode="selector"
          range="{{item.options}}"
          data-field="{{item.id}}"
          bindchange="onCustomFieldChange"
        >
          <view class="picker">
            <text class="picker-text">{{customData[item.id] || '请选择' + item.label}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>

        <!-- 多选 -->
        <view wx:if="{{item.type === 'multiselect'}}" class="multiselect-group">
          <checkbox-group data-field="{{item.id}}" bindchange="onMultiSelectChange">
            <label class="multiselect-option" wx:for="{{item.options}}" wx:key="*this" wx:for-item="option">
              <checkbox
                value="{{option}}"
                checked="{{multiSelectState[item.id] && multiSelectState[item.id][option]}}"
                color="#1989fa"
              />
              <text class="multiselect-text">{{option}}</text>
            </label>
          </checkbox-group>
        </view>
      </view>
    </view>
  </view>

  <view class="submission-admin-actions" wx:if="{{isEditMode && isTaskCreator}}">
    <button class="delete-btn" bindtap="deleteSubmissionRecord" disabled="{{photoProcessing || backgroundProcessing || (aiAnalysisEnabled && analysisState === 'analyzing')}}">删除提交</button>
  </view>

  <!-- 提交按钮 -->
  <view class="keyboard-spacer" wx:if="{{keyboardSpacerHeight > 0}}" style="height: {{keyboardSpacerHeight}}px;"></view>
  <view class="footer-placeholder"></view>
  <view class="footer">
    <button class="notify-btn" wx:if="{{isEditMode && canNotifySubmitter}}" bindtap="openNotificationDialog" disabled="{{notifying}}">通知</button>
    <button class="submit-btn" bindtap="submitPhoto" disabled="{{!photoPath || !!taskUnavailableMessage || !canSubmit || photoProcessing || (aiAnalysisEnabled && analysisState === 'analyzing')}}">
      {{taskUnavailableMessage ? '当前不可提交' : (backgroundProcessing ? '背景生成中...' : ((aiAnalysisEnabled && analysisState === 'analyzing') ? 'AI检查中...' : (photoProcessing ? '照片处理中...' : (isEditMode ? '更新' : '提交'))))}}
    </button>
  </view>

  <view class="notification-mask" wx:if="{{notificationDialogVisible}}" bindtap="closeNotificationDialog">
    <view class="notification-dialog" catchtap="preventDialogClose">
      <view class="notification-title">发送通知</view>
      <view class="notification-field">
        <text class="notification-label">审核状态</text>
        <input
          class="notification-input"
          value="{{notificationReviewStatus}}"
          maxlength="5"
          placeholder="请填写审核状态"
          adjust-position="{{false}}"
          bindinput="onNotificationReviewStatusInput"
        />
      </view>
      <view class="notification-field">
        <text class="notification-label">提示</text>
        <input
          class="notification-input"
          value="{{notificationPrompt}}"
          maxlength="20"
          placeholder="请填写提示"
          adjust-position="{{false}}"
          bindinput="onNotificationPromptInput"
        />
      </view>
      <view class="notification-dialog-actions">
        <button class="notification-cancel-btn" bindtap="closeNotificationDialog" disabled="{{notifying}}">取消</button>
        <button class="notification-send-btn" bindtap="sendNotification" disabled="{{notifying}}">{{notifying ? '发送中...' : '发送'}}</button>
      </view>
    </view>
  </view>
</view>
