.page {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx 180rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.page-loading,
.empty,
.loading-more {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.summary-card,
.history-card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.summary-title {
  display: block;
  color: #333;
  font-size: 34rpx;
  font-weight: bold;
  word-break: break-all;
}

.summary-desc {
  display: block;
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
}

.section-title {
  padding: 12rpx 4rpx 20rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}

.history-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.history-file {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 29rpx;
  font-weight: bold;
  word-break: break-all;
  overflow-wrap: break-word;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.status-pending,
.status-processing {
  color: #ff9500;
  background: #fff7e8;
}

.status-success {
  color: #07c160;
  background: #edf9f2;
}

.status-failed {
  color: #ff4444;
  background: #fff0f0;
}

.history-line {
  display: block;
  color: #666;
  font-size: 26rpx;
  line-height: 1.75;
  word-break: break-all;
  overflow-wrap: break-word;
}

.history-error {
  display: block;
  margin-top: 10rpx;
  color: #ff4444;
  font-size: 25rpx;
  line-height: 1.6;
}

.download-btn {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 20rpx;
  border-radius: 36rpx;
  text-align: center;
  color: #1989fa;
  background: #eef5ff;
  border: 1rpx solid #d6e8ff;
  font-size: 27rpx;
}

.expired-tip {
  display: block;
  margin-top: 16rpx;
  color: #999;
  font-size: 25rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.export-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  text-align: center;
  color: #fff;
  background: #1989fa;
  font-size: 30rpx;
}

.export-btn-disabled {
  background: #ccc;
}

.footer-tip {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  color: #999;
  font-size: 23rpx;
}
