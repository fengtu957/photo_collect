<view class="page">
  <view class="page-loading" wx:if="{{pageLoading}}">加载中...</view>

  <block wx:else>
    <view class="summary-card">
      <text class="summary-title">{{taskTitle}}</text>
      <text class="summary-desc">共 {{total}} 次导出记录，处理中状态会自动更新</text>
    </view>

    <view class="section-title">导出历史</view>

    <view class="empty" wx:if="{{records.length === 0}}">暂无导出记录</view>

    <view class="history-card" wx:for="{{records}}" wx:key="id">
      <view class="history-header">
        <text class="history-file">{{item.file_name}}</text>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="history-line">图片数量：{{item.count}} 张</text>
      <text class="history-line">创建时间：{{item.createdAtFormatted || '未知'}}</text>
      <text class="history-line" wx:if="{{item.exportedAtFormatted}}">完成时间：{{item.exportedAtFormatted}}</text>
      <text class="history-line" wx:if="{{item.filename_template}}">命名模板：{{item.filename_template}}</text>
      <text class="history-line" wx:if="{{item.availableUntilFormatted}}">下载保留至：{{item.availableUntilFormatted}}</text>
      <view class="download-btn" wx:if="{{item.canDownload}}" catchtap="copyDownloadLink" data-id="{{item.id}}">复制下载链接</view>
      <text class="expired-tip" wx:elif="{{item.status === 'success'}}">下载文件已过期</text>
    </view>

    <view class="loading-more" wx:if="{{loadingMore}}">加载中...</view>
  </block>

  <view class="footer">
    <view class="export-btn {{canStartExport ? '' : 'export-btn-disabled'}}" bindtap="goToEditor">
      {{records.length > 0 ? '重新导出' : '开始导出'}}
    </view>
    <text class="footer-tip" wx:if="{{!canStartExport}}">任务结束后才能导出</text>
  </view>
</view>
