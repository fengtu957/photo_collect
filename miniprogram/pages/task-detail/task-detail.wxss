/* 页面容器 */
.page {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page-loading {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  word-break: break-all;
  overflow-wrap: break-word;
  flex: 1;
}

.task-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.task-action-link {
  font-size: 28rpx;
  color: #1989fa;
  line-height: 1.6;
}

.card-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 分隔线 */
.divider {
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: #999;
  min-width: 160rpx;
}

.info-row .value {
  color: #333;
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

.status-text {
  color: #ff9500;
}

.share-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #d6e8ff;
}

.share-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

.share-entry-link {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1989fa;
  line-height: 1.6;
}

.entry-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e8f1ff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.entry-title {
  display: block;
  font-size: 28rpx;
  color: #1989fa;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.entry-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 章节标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

.section-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.section-action {
  margin-left: auto;
  font-size: 28rpx;
  color: #1989fa;
  padding: 8rpx 0 8rpx 24rpx;
}

/* 空状态 */
.empty {
  background: white;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 提交卡片 */
.submission-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #edf1f5;
  box-shadow: 0 8rpx 24rpx rgba(32, 55, 80, 0.06);
}

.submission-card-active {
  background: #f8fafc;
}

.submission-thumbnail {
  width: 200rpx;
  height: 248rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.submission-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 0;
}

.submission-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 4rpx;
  padding-right: 180rpx;
  box-sizing: border-box;
}

.submitter {
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.nickname {
  min-width: 0;
  max-width: 220rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #a0a7b0;
}

.submission-fields {
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

.submission-field-labels,
.submission-field-colons,
.submission-field-values {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.submission-field-labels {
  flex-shrink: 0;
  max-width: 156rpx;
}

.submission-field-colons {
  flex-shrink: 0;
}

.submission-field-values {
  flex: 1;
}

.submission-field-label {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.submission-field-colon {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
}

.submission-field-value {
  min-width: 0;
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1989fa;
  color: white;
  padding: 24rpx 60rpx;
  border-radius: 60rpx;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(25,137,250,0.4);
}

/* 任务管理员底栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: white;
  gap: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.btn-export {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  background: #07c160;
  color: white;
}

.btn-collaborate {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  background: #ff9500;
  color: white;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  background: #1989fa;
  color: white;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  background: #eef5ff;
  color: #1989fa;
  border: 1rpx solid #d6e8ff;
}

.btn-share {
  padding: 0;
}

.btn-share::after {
  border: none;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}

.invite-modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.48);
}

.invite-modal {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #fff;
}

.invite-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-modal-title {
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #333;
}

.invite-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 48rpx;
  color: #999;
}

.invite-modal-desc {
  display: block;
  margin: 12rpx 0 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.invite-role-button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  height: auto;
  margin: 0 0 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  text-align: left;
}

.invite-role-button::after {
  border: none;
}

.invite-role-admin {
  background: #eef5ff;
  color: #1989fa;
}

.invite-role-collaborator {
  margin-bottom: 0;
  background: #fff5e8;
  color: #d97706;
}

.invite-role-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
}

.invite-role-desc {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #666;
}
