/* 页面容器 */
.page {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page-loading {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  word-break: break-all;
  overflow-wrap: break-word;
  flex: 1;
}

.task-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.task-action-link {
  font-size: 28rpx;
  color: #1989fa;
  line-height: 1.6;
}

.card-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 分隔线 */
.divider {
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: #999;
  min-width: 160rpx;
}

.info-row .value {
  color: #333;
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

.status-text {
  color: #ff9500;
}

.share-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #d6e8ff;
}

.share-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

.share-entry-link {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1989fa;
  line-height: 1.6;
}

.entry-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e8f1ff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.entry-title {
  display: block;
  font-size: 28rpx;
  color: #1989fa;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.entry-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 章节标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

.section-action {
  margin-left: auto;
  font-size: 28rpx;
  color: #1989fa;
  padding: 8rpx 0 8rpx 24rpx;
}

/* 空状态 */
.empty {
  background: white;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 提交卡片 */
.submission-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #edf1f5;
  box-shadow: 0 8rpx 24rpx rgba(32, 55, 80, 0.06);
}

.submission-thumbnail {
  width: 168rpx;
  height: 208rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.submission-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.submission-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.submitter {
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.nickname {
  min-width: 0;
  max-width: 220rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time {
  display: block;
  margin-top: auto;
  font-size: 24rpx;
  color: #a0a7b0;
}

.edit-link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1989fa;
  padding: 6rpx 0 6rpx 16rpx;
}

.first-field {
  margin-top: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.first-field-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 23rpx;
  color: #8a94a3;
}

.first-field-value {
  display: -webkit-box;
  font-size: 28rpx;
  color: #2f3540;
  line-height: 1.45;
  word-break: break-all;
  overflow-wrap: break-word;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1989fa;
  color: white;
  padding: 24rpx 60rpx;
  border-radius: 60rpx;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(25,137,250,0.4);
}

/* 创建者底栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: white;
  gap: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.btn-export {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  background: #07c160;
  color: white;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  background: #1989fa;
  color: white;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  background: #eef5ff;
  color: #1989fa;
  border: 1rpx solid #d6e8ff;
}

.btn-share {
  padding: 0;
}

.btn-share::after {
  border: none;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}
