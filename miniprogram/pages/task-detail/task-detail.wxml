<view class="page">
  <view class="page-loading" wx:if="{{pageLoading}}">
    <text class="page-loading-text">加载中...</text>
  </view>

  <block wx:elif="{{task}}">
  <!-- 任务信息卡片 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">{{task.title}}</view>
      <view class="task-actions" wx:if="{{isCreator}}">
        <text class="task-action-link" catchtap="editTask">编辑</text>
        <text class="task-action-link" catchtap="copyTask">复制</text>
      </view>
    </view>
    <view class="card-desc" wx:if="{{task.description}}">{{task.description}}</view>

    <view class="divider"></view>

    <view class="info-row" wx:if="{{task.task_code}}">
      <text class="label">任务码：</text>
      <text class="value">{{task.task_code}}</text>
    </view>

    <view class="info-row">
      <text class="label">照片规格：</text>
      <text class="value">{{task.photo_spec.name}} ({{task.photo_spec.width}}×{{task.photo_spec.height}})</text>
    </view>

    <view class="info-row" wx:if="{{task.photo_spec.background_color}}">
      <text class="label">背景色要求：</text>
      <text class="value">{{task.photo_spec.background_color}}</text>
    </view>

    <view class="info-row" wx:if="{{task.photo_spec.max_size_kb > 0}}">
      <text class="label">大小限制：</text>
      <text class="value">{{task.photo_spec.max_size_kb}}K，超出自动压缩</text>
    </view>

    <view class="info-row">
      <text class="label">AI分析：</text>
      <text class="value">{{aiAnalysisEnabled ? '已开启' : '已关闭'}}</text>
    </view>

    <view class="info-row">
      <text class="label">开始时间：</text>
      <text class="value">{{startTime}}</text>
    </view>

    <view class="info-row">
      <text class="label">截止时间：</text>
      <text class="value">{{endTime}}</text>
    </view>

    <view class="info-row">
      <text class="label">最多人数：</text>
      <text class="value">{{submissionLimitText}}</text>
    </view>

    <view class="info-row" wx:if="{{taskStatusText}}">
      <text class="label">当前状态：</text>
      <text class="value status-text">{{taskStatusText}}</text>
    </view>

    <view class="info-row" wx:if="{{task.custom_fields && task.custom_fields.length > 0}}">
      <text class="label">采集字段：</text>
      <text class="value">{{customFieldSummary}}</text>
    </view>

    <view class="share-entry">
      <text class="share-entry-text">可直接分享给参与者，也可保存小程序码备用，支持微信扫码参与</text>
      <text class="share-entry-link" catchtap="saveTaskMiniCode">保存小程序码</text>
    </view>

  </view>

  <view class="entry-card" wx:if="{{!isCreator && fromShare}}">
    <text class="entry-title">你是通过分享或扫码进入的参与者页面</text>
    <text class="entry-desc">先确认照片规格和采集字段，再点击下方上传照片。</text>
  </view>

  <!-- 提交列表 -->
  <view class="section-header">
    <text class="section-title">我的提交</text>
    <text class="section-count">({{total}})</text>
    <text class="section-hint" wx:if="{{submissions.length > 0}}">点击提交可编辑</text>
    <text class="section-action" wx:if="{{isCreator}}" bindtap="viewAllSubmissions">全部提交</text>
  </view>

  <view class="empty" wx:if="{{submissions.length === 0}}">
    <text class="empty-text">你还没有提交，点击下方上传照片</text>
  </view>

  <view class="submission-card" wx:for="{{submissions}}" wx:key="id" bindtap="editSubmission" data-id="{{item.id}}" hover-class="submission-card-active">
    <image
      class="submission-thumbnail"
      src="{{item.photo.thumbnail_url || item.photo.url}}"
      mode="aspectFill"
    />
    <view class="submission-content">
      <view class="submission-fields" wx:if="{{item.customFieldItems.length}}">
        <view class="submission-field-labels">
          <text class="submission-field-label" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">{{field.label}}</text>
        </view>
        <view class="submission-field-colons">
          <text class="submission-field-colon" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">:</text>
        </view>
        <view class="submission-field-values">
          <text class="submission-field-value" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">{{field.value}}</text>
        </view>
      </view>
      <view class="submission-meta">
        <view class="submitter">
          <image class="avatar" src="{{item.user_info.avatar_url}}" mode="aspectFill" />
          <text class="nickname">{{item.user_info.nick_name}}</text>
        </view>
      </view>
    </view>
    <text class="time">{{item.createdAtFormatted}}</text>
  </view>

  <!-- 分页状态 -->
  <view class="load-more" wx:if="{{loadingMore}}">
    <text class="load-more-text">加载中...</text>
  </view>
  <view class="load-more" wx:elif="{{!hasMore && submissions.length > 0}}">
    <text class="load-more-text">已加载全部</text>
  </view>

  <!-- 任务管理员底栏 -->
  <view class="footer" wx:if="{{isCreator}}">
    <button class="btn-secondary btn-share" open-type="share">分享任务</button>
    <view class="btn-primary" bindtap="goToUpload">上传照片</view>
    <view class="btn-export" wx:if="{{taskEnded}}" bindtap="goToExports">导出</view>
    <view class="btn-collaborate" wx:else bindtap="openCollaboration">协作</view>
  </view>

  <!-- 非创建者底栏 -->
  <view class="footer" wx:else>
    <button class="btn-secondary btn-share" open-type="share">分享任务</button>
    <view class="btn-primary" bindtap="goToUpload">
      <text>{{mySubmissionId && !canSubmitMultiple ? '编辑提交' : '上传照片'}}</text>
    </view>
  </view>
  </block>

  <view class="invite-modal-mask" wx:if="{{inviteModalVisible}}" bindtap="closeInviteModal" catchtouchmove="stopPropagation">
    <view class="invite-modal" catchtap="stopPropagation">
      <view class="invite-modal-header">
        <text class="invite-modal-title">选择邀请身份</text>
        <text class="invite-modal-close" bindtap="closeInviteModal">×</text>
      </view>
      <text class="invite-modal-desc">邀请通过微信好友发送，每个邀请仅能被一人领取。</text>
      <button class="invite-role-button invite-role-admin" open-type="share" data-role="admin">
        <text class="invite-role-title">新增管理员</text>
        <text class="invite-role-desc">可管理任务、审核和导出</text>
      </button>
      <button class="invite-role-button invite-role-collaborator" open-type="share" data-role="collaborator">
        <text class="invite-role-title">新增协作员</text>
        <text class="invite-role-desc">普通用户权限，可多次上传</text>
      </button>
    </view>
  </view>
</view>
