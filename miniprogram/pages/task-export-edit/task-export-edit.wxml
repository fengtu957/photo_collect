<view class="page">
  <view class="page-loading" wx:if="{{pageLoading}}">加载中...</view>

  <block wx:elif="{{task}}">
    <view class="card">
      <text class="task-title">{{taskTitle}}</text>
      <text class="label">文件命名模板</text>
      <textarea
        class="textarea"
        value="{{exportTemplate}}"
        placeholder="请输入图片命名模板，不要写扩展名"
        bindinput="onExportTemplateInput"
        adjust-position="{{false}}"
        maxlength="-1"
      ></textarea>
      <text class="tip">{{exportTemplateHint}}</text>
    </view>

    <view class="card example-card">
      <text class="example-title">命名示例</text>
      <text class="example-line">{index}：三位序号，例如 001</text>
      <text class="example-line">{nick_name}：提交者昵称</text>
      <text class="example-line">{created_at}：提交时间</text>
      <text class="example-line">{task_title}：任务标题</text>
      <text class="example-line">{field:字段名}：采集字段内容</text>
    </view>
  </block>

  <view class="footer" wx:if="{{task}}">
    <view class="submit-btn {{submitting ? 'submit-btn-disabled' : ''}}" bindtap="submitExport">
      {{submitting ? '正在创建...' : '确认导出'}}
    </view>
  </view>
</view>
