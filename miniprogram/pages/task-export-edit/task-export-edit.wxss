.page {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx 20rpx 140rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.page-loading {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.task-title {
  display: block;
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  color: #333;
  font-size: 34rpx;
  font-weight: bold;
  word-break: break-all;
  overflow-wrap: break-word;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}

.textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #d6e8ff;
  border-radius: 12rpx;
  background: #f8fbff;
  color: #333;
  font-size: 30rpx;
  line-height: 1.6;
}

.textarea::placeholder {
  color: #999;
}

.tip {
  display: block;
  margin-top: 16rpx;
  color: #666;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

.example-title {
  display: block;
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
}

.example-line {
  display: block;
  color: #666;
  font-size: 25rpx;
  line-height: 1.8;
  word-break: break-all;
  overflow-wrap: break-word;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  text-align: center;
  background: #1989fa;
  color: #fff;
  font-size: 30rpx;
}

.submit-btn-disabled {
  background: #ccc;
}
