.page {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-loading {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-loading-text,
.load-more-text {
  font-size: 28rpx;
  color: #999;
}

.section-header {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-task {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  overflow-wrap: break-word;
}

.section-count {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.empty {
  width: 100%;
  box-sizing: border-box;
  background: white;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.submission-waterfall {
  width: 100%;
  box-sizing: border-box;
}

.submission-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #edf1f5;
  box-shadow: 0 8rpx 24rpx rgba(32, 55, 80, 0.06);
}

.submission-thumbnail {
  width: 168rpx;
  height: 208rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.submission-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.submission-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.submitter {
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.nickname {
  min-width: 0;
  max-width: 220rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time {
  display: block;
  margin-top: auto;
  font-size: 24rpx;
  color: #a0a7b0;
}

.edit-link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1989fa;
  padding: 6rpx 0 6rpx 16rpx;
}

.first-field {
  margin-top: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.first-field-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 23rpx;
  color: #8a94a3;
}

.first-field-value {
  display: -webkit-box;
  font-size: 28rpx;
  color: #2f3540;
  line-height: 1.45;
  word-break: break-all;
  overflow-wrap: break-word;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}
