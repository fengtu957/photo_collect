.page {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-loading {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-loading-text,
.load-more-text {
  font-size: 28rpx;
  color: #999;
}

.section-header {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-task {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  overflow-wrap: break-word;
}

.section-count {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.section-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.view-toggle {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid #dfe4ea;
  border-radius: 10rpx;
  background: #fff;
}

.view-toggle-active {
  background: #f1f4f7;
}

.view-icon-grid {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.view-icon-cell {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #7d8794;
}

.view-icon-list {
  width: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.view-icon-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #7d8794;
}

.empty {
  width: 100%;
  box-sizing: border-box;
  background: white;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.submission-waterfall {
  width: 100%;
  box-sizing: border-box;
}

.submission-grid {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.submission-grid-photo {
  width: 168rpx;
  height: 208rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #eef1f4;
}

.submission-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #edf1f5;
  box-shadow: 0 8rpx 24rpx rgba(32, 55, 80, 0.06);
}

.submission-card-active {
  background: #f8fafc;
}

.submission-thumbnail {
  width: 200rpx;
  height: 248rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.submission-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 0;
}

.submission-meta {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 4rpx;
  padding-right: 180rpx;
  box-sizing: border-box;
}

.submitter {
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.nickname {
  min-width: 0;
  max-width: 220rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #a0a7b0;
}

.submission-fields {
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

.submission-field-labels,
.submission-field-colons,
.submission-field-values {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.submission-field-labels {
  flex-shrink: 0;
  max-width: 156rpx;
}

.submission-field-colons {
  flex-shrink: 0;
}

.submission-field-values {
  flex: 1;
}

.submission-field-label {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.submission-field-colon {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
}

.submission-field-value {
  min-width: 0;
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f7885;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}
