.page {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-loading {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.page-loading-text,
.load-more-text {
  font-size: 28rpx;
  color: #999;
}

.section-header {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-task {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  overflow-wrap: break-word;
}

.section-count {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.empty {
  width: 100%;
  box-sizing: border-box;
  background: white;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.submission-waterfall {
  width: 100%;
  box-sizing: border-box;
}

.submission-card {
  width: 100%;
  box-sizing: border-box;
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.submission-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 4rpx;
  word-break: break-all;
  overflow-wrap: break-word;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.submission-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.edit-link,
.delete-link {
  font-size: 28rpx;
  padding: 8rpx 12rpx;
}

.edit-link {
  color: #1989fa;
}

.delete-link {
  color: #ff4444;
}

.ai-evaluation {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.ai-success {
  font-size: 26rpx;
  color: #07c160;
}

.issues,
.suggestions {
  margin-top: 12rpx;
}

.issues-title,
.suggestions-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
}

.issue-item,
.suggestion-item {
  display: block;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  word-break: break-all;
  overflow-wrap: break-word;
}

.ai-pending {
  font-size: 26rpx;
  color: #ff9500;
}

.ai-error {
  font-size: 26rpx;
  color: #ff4444;
  word-break: break-all;
  overflow-wrap: break-word;
}

.custom-data {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.custom-item {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.custom-label {
  color: #999;
  min-width: 120rpx;
}

.custom-value {
  color: #333;
  flex: 1;
  word-break: break-all;
  overflow-wrap: break-word;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}
