<view class="page">
  <view class="page-loading" wx:if="{{pageLoading}}">
    <text class="page-loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view class="section-header">
      <view class="section-copy">
        <text class="section-title">全部提交</text>
        <text class="section-task" wx:if="{{task && task.title}}">{{task.title}}</text>
      </view>
      <view class="section-actions">
        <text class="section-count">{{total}} 条</text>
        <view
          class="view-toggle"
          bindtap="toggleViewMode"
          hover-class="view-toggle-active"
          aria-role="button"
          aria-label="{{viewMode === 'list' ? '切换为图片视图' : '切换为列表视图'}}"
        >
          <view class="view-icon-grid" wx:if="{{viewMode === 'list'}}">
            <view class="view-icon-cell"></view>
            <view class="view-icon-cell"></view>
            <view class="view-icon-cell"></view>
            <view class="view-icon-cell"></view>
          </view>
          <view class="view-icon-list" wx:else>
            <view class="view-icon-line"></view>
            <view class="view-icon-line"></view>
            <view class="view-icon-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{submissions.length === 0}}">
      <text class="empty-text">暂无提交记录</text>
    </view>

    <block wx:else>
      <view class="submission-grid" wx:if="{{viewMode === 'grid'}}">
        <image
          class="submission-grid-photo"
          wx:for="{{submissions}}"
          wx:key="id"
          src="{{item.photo.thumbnail_url || item.photo.url}}"
          mode="aspectFill"
          bindtap="editSubmission"
          data-id="{{item.id}}"
          lazy-load="{{true}}"
        />
      </view>

      <view class="submission-waterfall" wx:else>
      <view class="submission-card" wx:for="{{submissions}}" wx:key="id" bindtap="editSubmission" data-id="{{item.id}}" hover-class="submission-card-active">
        <image
          class="submission-thumbnail"
          src="{{item.photo.thumbnail_url || item.photo.url}}"
          mode="aspectFill"
        />
        <view class="submission-content">
          <view class="submission-fields" wx:if="{{item.customFieldItems.length}}">
            <view class="submission-field-labels">
              <text class="submission-field-label" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">{{field.label}}</text>
            </view>
            <view class="submission-field-colons">
              <text class="submission-field-colon" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">:</text>
            </view>
            <view class="submission-field-values">
              <text class="submission-field-value" wx:for="{{item.customFieldItems}}" wx:for-item="field" wx:key="id">{{field.value}}</text>
            </view>
          </view>
          <view class="submission-meta">
            <view class="submitter">
              <image class="avatar" src="{{item.user_info.avatar_url}}" mode="aspectFill" />
              <text class="nickname">{{item.user_info.nick_name}}</text>
            </view>
          </view>
        </view>
        <text class="time">{{item.createdAtFormatted}}</text>
      </view>
      </view>
    </block>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore && submissions.length > 0}}">
      <text class="load-more-text">已加载全部</text>
    </view>
  </block>
</view>
