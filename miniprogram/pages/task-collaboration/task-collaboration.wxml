<view class="page">
  <view wx:if="{{pageLoading}}" class="state">加载中...</view>
  <view wx:elif="{{loadError}}" class="state error">{{loadError}}</view>
  <block wx:else>
    <view class="tabs">
      <view class="tab {{activeTab === 'admin' ? 'active' : ''}}" wx:if="{{viewerRole === 'creator'}}" bindtap="switchTab" data-tab="admin">管理员</view>
      <view class="tab {{activeTab === 'collaborator' ? 'active' : ''}}" bindtap="switchTab" data-tab="collaborator">协作人员</view>
    </view>

    <view class="panel">
      <view class="panel-header">
        <text class="panel-title">{{activeTab === 'admin' ? '管理员' : '协作人员'}}</text>
        <text class="panel-count">{{activeTab === 'admin' ? adminUserIds.length : collaboratorUserIds.length}} 人</text>
      </view>
      <view class="member-row" wx:for="{{activeTab === 'admin' ? adminUserIds : collaboratorUserIds}}" wx:key="*this">
        <view class="member-main">
          <view class="avatar-placeholder">{{activeTab === 'admin' ? '管' : '协'}}</view>
          <text class="member-id">{{item}}</text>
        </view>
        <button class="remove-button" wx:if="{{item !== currentUserId && item !== ownerUserId && (viewerRole === 'creator' || activeTab === 'collaborator')}}" data-user-id="{{item}}" data-role="{{activeTab}}" bindtap="removeMember">解除</button>
      </view>
      <view class="empty" wx:if="{{(activeTab === 'admin' ? adminUserIds.length : collaboratorUserIds.length) === 0}}">暂无成员</view>
    </view>

    <view class="invite-panel">
      <view class="invite-title">发起邀请</view>
      <view class="invite-actions">
        <button class="invite-button admin" wx:if="{{canInviteAdmin && invitationTokens.admin.token}}" open-type="share" data-role="admin">邀请管理员</button>
        <button class="invite-button collaborator" wx:if="{{canInviteCollaborator && invitationTokens.collaborator.token}}" open-type="share" data-role="collaborator">邀请协作人员</button>
      </view>
    </view>
  </block>
</view>
